usage = ['Generic Desktop', 'System Wake Timer']
    [[applicationCollection.featureReport]]
    id = 1

        # Indicate the lowest power-state of the system that this timer may trigger a wake.
        # If system goes to a lower power-state, regardless of timer settings, will NOT trigger a wake.
        [[applicationCollection.featureReport.logicalCollection]]
        usage = ['Generic Desktop', 'Lowest System Wakeable Power State']

