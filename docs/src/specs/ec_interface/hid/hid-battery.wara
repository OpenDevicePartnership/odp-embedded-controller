# Draft descriptor for the proposed Control Method Battery top-level collection.
# Proposed usages are added to the existing Battery System Usage Page (0x85).
# Multi-byte integers are little-endian. Fields declared with a signed 32-bit
# logical range are interpreted as raw ACPI DWORD values by the protocol.

[[usagePage]]
id = 0x85
name = "Battery System"

    [[usagePage.usage]]
    id = 0x100
    name = "Control Method Battery"
    types = ['CA']

